{
  "1": {"class_type": "CheckpointLoaderSimple", "_meta": {"title": "Checkpoint"},
        "inputs": {"ckpt_name": "juggernautXL_ragnarokBy.safetensors"}},
  "2": {"class_type": "CLIPTextEncode", "_meta": {"title": "UI:Positiv"},
        "inputs": {"clip": ["1", 1], "text": "RAW photo, modern living room, concrete walls, oak floor, large windows, soft daylight, photorealistic, 8k uhd, DSLR"}},
  "3": {"class_type": "CLIPTextEncode", "_meta": {"title": "UI:Negativ"},
        "inputs": {"clip": ["1", 1], "text": "cartoon, illustration, drawing, painting, cgi, 3d render, plastic, anime, sketch, blurry"}},
  "4": {"class_type": "LoadImage", "_meta": {"title": "BL:beauty"},
        "inputs": {"image": "cb_beauty.png"}},
  "5": {"class_type": "Canny", "_meta": {"title": "UI:Canny-Kanten"},
        "inputs": {"image": ["4", 0], "low_threshold": 0.2, "high_threshold": 0.6}},
  "6": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet Canny"},
        "inputs": {"control_net_name": "controlnet-canny-sdxl.safetensors"}},
  "7": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "UI:Canny"},
        "inputs": {"positive": ["2", 0], "negative": ["3", 0], "control_net": ["6", 0], "image": ["5", 0],
                   "strength": 0.8, "start_percent": 0.0, "end_percent": 0.8}},
  "8": {"class_type": "LoadImage", "_meta": {"title": "BL:depth"},
        "inputs": {"image": "cb_depth.png"}},
  "9": {"class_type": "ControlNetLoader", "_meta": {"title": "ControlNet Depth"},
        "inputs": {"control_net_name": "controlnet-depth-sdxl.safetensors"}},
  "10": {"class_type": "ControlNetApplyAdvanced", "_meta": {"title": "UI:Depth"},
         "inputs": {"positive": ["7", 0], "negative": ["7", 1], "control_net": ["9", 0], "image": ["8", 0],
                    "strength": 0.6, "start_percent": 0.0, "end_percent": 0.8}},
  "11": {"class_type": "EmptyLatentImage", "_meta": {"title": "BL:size"},
         "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
  "12": {"class_type": "KSampler", "_meta": {"title": "UI:Sampler"},
         "inputs": {"model": ["1", 0], "positive": ["10", 0], "negative": ["10", 1], "latent_image": ["11", 0],
                    "seed": 0, "steps": 25, "cfg": 7.0, "sampler_name": "euler_ancestral", "scheduler": "normal",
                    "denoise": 1.0}},
  "13": {"class_type": "VAEDecode", "_meta": {"title": "VAE Decode"},
         "inputs": {"samples": ["12", 0], "vae": ["1", 2]}},
  "14": {"class_type": "SaveImage", "_meta": {"title": "BL:result"},
         "inputs": {"images": ["13", 0], "filename_prefix": "comfy_bridge/sdxl"}}
}
